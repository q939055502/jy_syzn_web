;
layui.use(['jquery', 'layer', 'table'], function () {
    var $ = layui.$ //重点处
        , layer = layui.layer
        , table = layui.table;

    window._post = function (url, data, _id, callback = null, timeout = 30000) {
        $('#' + _id).html('1');
        $.ajax({
            type: 'POST',
            url: url,
            data: data,
            dataType: 'json',
            timeout: timeout,
            success: function (res) {
                $('#' + _id).html('0');

                if (typeof (callback) === 'function') {
                    callback(res)
                } else {
                    layer.msg(res['msg']);
                }
            },
            error: function () {
                $('#' + _id).html('0');
                layer.msg('服务器出错');
            }
        })
    };
    window._msg = function (res, func = null) {
        if (res['code'] === 200) {
            layer.msg(res['msg'], {icon: 1, shade: 0.3, time: 2000}, function () {
                if (typeof (func) === 'function') {
                    func()
                } else {
                    var f = func
                }
            });


        } else {
            layer.msg(res['msg'], {icon: 2, shade: 0.3, time: 2000});
        }
    };
    window.daysBetween = function (sDate1, sDate2) {
//Date.parse() 解析一个日期时间字符串，并返回1970/1/1 午夜距离该日期时间的毫秒数
        var time1 = Date.parse(new Date(sDate1));
        var time2 = Date.parse(new Date(sDate2));
        var nDays = Math.abs(parseInt((time2 - time1) / 1000 / 3600 / 24));
        return nDays;
    };
    window._download = function () {
        var tb = table.render({
            response: {
                statusCode: 200
            },
            elem: '#downloadTable',
            url: '../contract_opt/download?dateRange=' + $('#dateRange').val() + '&conditions_value=' + $('#conditions_value').val() +
                '&conditions=' + $('#conditions').val(),
            title: '合同数据',
            cols: [[

                {field: 'date', align: 'center', title: '登记日期'},
                {field: 'no', align: 'center', title: '合同编号'},
                {field: 'pname', align: 'center', title: '工程名称'},
                {field: 'client', align: 'center', title: '委托单位'},
                {field: 'pay_typ', align: 'center', title: '付款方式'},
                {field: 'amount', align: 'center', title: '总金额'},
                {field: 'cnname', align: 'center', title: '业务登记'},
                {field: 'test_dept', align: 'center', title: '检测部门'},
                {field: 'test_project', align: 'center', title: '检测项目'},
                {field: 'charge_dept', align: 'center', title: '项目负责部门'},
                {field: 'charge_man', align: 'center', title: '项目负责人'},
                {field: 'charge_phone', align: 'center', title: '负责人电话'},
                {field: 'finished_work', align: 'center', title: '已完成工作量'},
                {field: 'finish_rate', align: 'center', title: '完成工作占比%'},
                {field: 'receivables', align: 'center', title: '应收款总额'},
                {field: 'received', align: 'center', title: '已收款总额'},
                {field: 'contract_copy', align: 'center', title: '合同留底'},
                {field: 'region', align: 'center', title: '地区'},
                {field: 'other', align: 'center', title: '其他'},
                {field: 'entrust', align: 'center', title: '委托方式'},
                {field: 'payer', align: 'center', title: '请款人'},
                {field: 'rewards_rate', align: 'center', title: '奖罚比例'},
                {field: 'remark', align: 'center', title: '备注内容'},
                {field: 'payment_progress', align: 'center', title: '请款进度'},
                {field: 'count_update_time', align: 'center', title: '结算更新时间'},
                {field: 'record_update_time', align: 'center', title: '记录更新时间'},
            ]],
            done: function (res, curr, count) {
                _msg(res, function () {
                    if (count === 0) {
                        layer.msg('无数据可以导出', {icon: 2});
                    } else {
                        table.exportFile(tb.config.id, tb.data, 'xls');
                    }
                });
                $('[lay-id="downloadTable"]').empty()
            }
        })
    };
    window.isEmptyObject = function (obj) {
        for (var key in obj) {
            return false;
        }
        return true;
    };
    window.οnlοad = function () {
        document.addEventListener('touchstart', function (event) {
            if (event.touches.length > 1) {
                event.preventDefault();
            }
        })
        var lastTouchEnd = 0;
        document.addEventListener('touchend', function (event) {
            var now = (new Date()).getTime();
            if (now - lastTouchEnd <= 300) {
                event.preventDefault();
            }
            lastTouchEnd = now;
        }, false)
    };



});